# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Meta Graph API Credentials for Facebook Page & Instagram Business Auto-Posting
META_ACCESS_TOKEN="YOUR_META_SYSTEM_OR_PAGE_ACCESS_TOKEN"
FB_PAGE_ID="YOUR_FACEBOOK_PAGE_ID"
IG_ACCOUNT_ID="YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID"

# Cloud Storage for Public HTTPS Poster URLs (Required for Meta Instagram Graph API)
# Option 1: Firebase Storage (Uses existing project storage bucket)
FIREBASE_STORAGE_BUCKET="vast-lightning-vzbz0.firebasestorage.app"

# Option 2: Cloudinary (Alternative lightweight public cloud storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# or CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Canva Branding Engine & Brand Template Autofill Credentials
# Obtained from Canva Developer Portal (https://www.canva.com/developers/)
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""
CANVA_TEMPLATE_ID="DAF8z_umer_realtors_luxury"
